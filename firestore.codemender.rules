rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and tenant isolation
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && request.auth.token.tenantId == tenantId;
    }

    function hasRole(requiredRole) {
      return isAuthenticated() && request.auth.token.role == requiredRole;
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Multi-tenant client data isolation
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if isTenantMember(tenantId);
    }

    // Append-only audit logs
    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (hasRole('admin') || hasRole('auditor'));
      allow create: if isAuthenticated() && request.resource.data.keys().hasAll(['timestamp', 'actor', 'action']);
      allow update, delete: if false;
    }
  }
}
